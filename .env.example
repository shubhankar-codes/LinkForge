PORT=3000
BASE_URL=http://localhost:3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=linkforge
# DB_USER defaults to your operating-system user
DB_PASSWORD=
JWT_SECRET=replace-with-a-long-random-secret
